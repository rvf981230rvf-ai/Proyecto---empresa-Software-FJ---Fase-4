# Reservation connects a client, a service, duration, and status.
class Reservation(Entity):
    def __init__(self, client, service, duration):
        super().__init__()

        if not isinstance(client, Client):
            raise ReservationError("A valid client is required.")

        if not isinstance(service, Service):
            raise ReservationError("A valid service is required.")

        try:
            service.validate_parameters(duration)
        except ServiceError as error:
            raise ReservationError(
                "Reservation could not be created because its service parameters are invalid."
            ) from error

        self.client = client
        self.service = service
        self.duration = duration
        self._status = "Pending"
        self.total_cost = None

    @property
    def status(self):
        return self._status

    def confirm(self):
        if self._status != "Pending":
            raise ReservationError(
                f"Only pending reservations can be confirmed. Current status: {self._status}."
            )

        self._status = "Confirmed"
        logger.info("Reservation %s was confirmed.", self.entity_id)

    def cancel(self):
        if self._status not in ("Pending", "Confirmed"):
            raise ReservationError(
                f"Reservation cannot be cancelled from status {self._status}."
            )

        self._status = "Cancelled"
        logger.info("Reservation %s was cancelled.", self.entity_id)

    def process(self, tax_rate=0, discount=0):
        if self._status != "Confirmed":
            raise ReservationError("Only confirmed reservations can be processed.")

        try:
            self.total_cost = self.service.calculate_cost(
                self.duration, tax_rate, discount
            )
        except ServiceError as error:
            # Exception chaining preserves the original cause.
            raise ReservationError(
                "Reservation processing failed because the service could not calculate its cost."
            ) from error

        self._status = "Processed"
        logger.info(
            "Reservation %s was processed. Total: $%.2f",
            self.entity_id,
            self.total_cost,
        )
        return self.total_cost

    def describe(self):
        return (
            f"Reservation {self.entity_id}: {self.client.name}, "
            f"{self.service.name}, {self.duration}, {self._status}"
        )


# In-memory collections. No database is used.
clients = []
services = []
reservations = []


# Runs each scenario independently so one error does not stop the program.
operation_number = 0


def run_operation(label, action):
    global operation_number
    operation_number += 1

    print(f"\nOperation {operation_number}: {label}")

    try:
        result = action()
    except ApplicationError as error:
        logger.exception("Operation failed: %s", label)
        print(f"Handled error: {error}")
        return None
    except Exception as error:
        # Catch unexpected errors too, keeping the demonstration running.
        logger.exception("Unexpected error during: %s", label)
        print(f"Unexpected error handled: {error}")
        return None
    else:
        logger.info("Operation completed: %s", label)
        print("Completed successfully.")
        return result
    finally:
        print("Operation finished.")


# 1. Register a valid client.
client_1 = run_operation(
    "Register a valid client",
    lambda: clients.append(Client("Jordan Lee", "jordan@example.com")),
)
client_1 = clients[-1] if clients else None

# 2. Try to register a client with an invalid email.
run_operation(
    "Reject a client with an invalid email",
    lambda: Client("Morgan Smith", "invalid-email"),
)

# 3. Register another valid client.
run_operation(
    "Register a second valid client",
    lambda: clients.append(Client("Taylor Kim", "taylor@example.com")),
)
client_2 = clients[-1]

# 4-6. Create the three valid service types.
run_operation(
    "Create a room reservation service",
    lambda: services.append(RoomReservation(100)),
)
run_operation(
    "Create an equipment rental service",
    lambda: services.append(EquipmentRental(50)),
)
run_operation(
    "Create a consulting service",
    lambda: services.append(SpecializedConsulting(150)),
)

room_service = services[0]
equipment_service = services[1]
consulting_service = services[2]

# 7. Try to create a service with an invalid price.
run_operation(
    "Reject a service with a negative price",
    lambda: RoomReservation(-20),
)

# 8. Create a valid reservation.
def create_reservation():
    reservation = Reservation(client_1, room_service, 2)
    reservations.append(reservation)
    return reservation


reservation_1 = run_operation("Create a valid room reservation", create_reservation)

# 9. Confirm the reservation.
run_operation("Confirm the room reservation", reservation_1.confirm)

# 10. Process it with tax and discount.
run_operation(
    "Process reservation with tax and discount",
    lambda: print(f"Total cost: ${reservation_1.process(0.19, 0.10):.2f}"),
)

# 11. Try to cancel an already processed reservation.
run_operation(
    "Reject cancellation of a processed reservation",
    reservation_1.cancel,
)

# 12. Try to create a reservation with a missing client.
run_operation(
    "Reject a reservation with a missing client",
    lambda: Reservation(None, room_service, 1),
)

# 13. Create a second valid reservation.
def create_second_reservation():
    reservation = Reservation(client_2, equipment_service, 3)
    reservations.append(reservation)
    return reservation


reservation_2 = run_operation(
    "Create a valid equipment reservation",
    create_second_reservation,
)

# 14. Confirm the second reservation.
run_operation("Confirm the equipment reservation", reservation_2.confirm)

# 15. Simulate the service becoming unavailable before processing.
def process_unavailable_service():
    equipment_service.available = False
    return reservation_2.process()


run_operation(
    "Handle a service that becomes unavailable before processing",
    process_unavailable_service,
)

