from abc import ABC, abstractmethod
import logging
import math


# Log events and errors to a file.
logging.basicConfig(
    filename="software_fj.log",
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
)
logger = logging.getLogger("SoftwareFJ")


# Custom exceptions.
class ApplicationError(Exception):
    """Base exception for the application."""


class ValidationError(ApplicationError):
    """Raised when input data is invalid."""


class ClientError(ValidationError):
    """Raised for client-related errors."""


class ServiceError(ValidationError):
    """Raised for service-related errors."""


class ReservationError(ApplicationError):
    """Raised for reservation-related errors."""


# General abstract entity.
class Entity(ABC):
    _next_id = 1

    def __init__(self):
        self._entity_id = Entity._next_id
        Entity._next_id += 1

    @property
    def entity_id(self):
        return self._entity_id

    @abstractmethod
    def describe(self):
        """Return a description of the entity."""


# Client with encapsulated personal data.
class Client(Entity):
    def __init__(self, name, email):
        super().__init__()

        if not isinstance(name, str) or not name.strip():
            raise ClientError("Client name must be a non-empty string.")

        if not isinstance(email, str) or "@" not in email or "." not in email:
            raise ClientError("Client email address is invalid.")

        self.__name = name.strip()
        self.__email = email.strip()

    @property
    def name(self):
        return self.__name

    @property
    def email(self):
        return self.__email

    def describe(self):
        return f"Client {self.name} ({self.email})"


# Abstract service class.
class Service(Entity, ABC):
    def __init__(self, name, price, available=True):
        super().__init__()

        if not isinstance(name, str) or not name.strip():
            raise ServiceError("Service name must be a non-empty string.")

        if (
            not isinstance(price, (int, float))
            or isinstance(price, bool)
            or not math.isfinite(price)
            or price <= 0
        ):
            raise ServiceError("Service price must be a positive number.")

        self.name = name.strip()
        self.price = float(price)
        self.available = available

    @property
    def available(self):
        return self._available

    @available.setter
    def available(self, value):
        if not isinstance(value, bool):
            raise ServiceError("Service availability must be True or False.")
        self._available = value

    def _validate_common(self, duration, unit):
        if not self.available:
            raise ServiceError(f"{self.name} is currently unavailable.")

        if (
            not isinstance(duration, (int, float))
            or isinstance(duration, bool)
            or not math.isfinite(duration)
            or duration <= 0
        ):
            raise ServiceError(f"{unit.capitalize()} must be a positive number.")

    def _calculate_total(self, duration, tax_rate, discount):
        for value, label in (
            (tax_rate, "Tax rate"),
            (discount, "Discount"),
        ):
            if (
                not isinstance(value, (int, float))
                or isinstance(value, bool)
                or not math.isfinite(value)
                or value < 0
                or value > 1
            ):
                raise ServiceError(f"{label} must be between 0 and 1.")

        subtotal = self.price * duration
        return subtotal * (1 + tax_rate) * (1 - discount)

    @abstractmethod
    def validate_parameters(self, duration):
        """Validate service-specific parameters."""

    @abstractmethod
    def calculate_cost(self, duration, tax_rate=0, discount=0):
        """Calculate the cost for this service."""

    @abstractmethod
    def describe(self):
        """Describe this service."""


# Specialized service 1.
class RoomReservation(Service):
    def __init__(self, price_per_hour, available=True):
        super().__init__("Room reservation", price_per_hour, available)

    def validate_parameters(self, duration):
        self._validate_common(duration, "hours")

    def calculate_cost(self, duration, tax_rate=0, discount=0):
        self.validate_parameters(duration)
        return self._calculate_total(duration, tax_rate, discount)

    def describe(self):
        return f"{self.name}: ${self.price:.2f} per hour"


